# Bu faylı .env adı ilə kopyalayın və dəyərləri Azure Portal → Translator resursu → "Keys and Endpoint"-dən götürün.
# .env faylını heç kimlə paylaşmayın.
AZURE_TRANSLATOR_KEY=
# Resursun "Location/Region" dəyəri (məs. northeurope); Global resurs üçün: global
AZURE_TRANSLATOR_REGION=global

# Claude API açarı (saytda B1/B2 sadə ingilis dilinə çevirmə üçün): https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
